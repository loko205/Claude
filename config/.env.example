# Solana Wallet
SOLANA_PRIVATE_KEY=your_base58_private_key_here
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional: Helius RPC (faster, recommended)
# SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Optional: CEX API Keys
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Hyperliquid (Perpetuals)
HL_PRIVATE_KEY=your_eth_private_key_here
HL_ACCOUNT_ADDRESS=0xYourMainWalletAddress
HL_TESTNET=true
HL_DEFAULT_LEVERAGE=3
HL_LEVERAGE_CROSS=true

# Exchange Selection: "solana" or "hyperliquid"
EXCHANGE=solana

# Trading Config
PAPER_TRADING=true
MAX_TRADE_SIZE_USDC=10
DAILY_LOSS_LIMIT_USDC=20
MIN_PROFIT_BPS=10

# Football Value Betting
FOOTBALL_DATA_API_KEY=your_key_here  # https://www.football-data.org/client/register
ODDS_API_KEY=your_key_here           # https://the-odds-api.com/#get-access
FOOTBALL_BANKROLL=100.0
FOOTBALL_MIN_EDGE=5.0
FOOTBALL_KELLY_FRACTION=0.25
FOOTBALL_SEASON=2025
FOOTBALL_LEAGUES=PL,BL1,SA,PD,FL1
